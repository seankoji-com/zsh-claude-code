#compdef claude claude-code

# Completions for the Claude Code CLI, checked against `claude --help` and each
# subcommand's --help (Claude Code 2.1.283). scripts/completion-drift.sh
# reports anything the installed CLI shows that this file does not.

# Main completion function
_claude_code() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    local -a commands
    commands=(
        'agents:Manage background agents'
        'attach:Open a background session in this terminal'
        'auth:Manage authentication'
        'auto-mode:Inspect or reset auto mode classifier configuration'
        'doctor:Check the health of your Claude Code installation'
        'gateway:Run the enterprise auth/telemetry gateway'
        'import:Import config from another AI coding agent'
        'install:Install Claude Code native build'
        'logs:Print a background session'"'"'s recent terminal output'
        'mcp:Configure and manage MCP servers'
        'plugin:Manage Claude Code plugins'
        'plugins:Manage Claude Code plugins'
        'project:Manage Claude Code project state'
        'respawn:Restart a background session on the current version'
        'rm:Delete a background session and its worktree'
        'setup-token:Set up a long-lived authentication token'
        'stop:Stop a background session'
        'kill:Stop a background session'
        'ultrareview:Run a cloud-hosted multi-agent code review'
        'update:Check for updates and install if available'
        'upgrade:Check for updates and install if available'
    )

    _arguments -C \
        '(- *)'{-h,--help}'[Display help]' \
        '(- *)'{-v,--version}'[Output the version number]' \
        '*--add-dir[Additional directories to allow tool access to]:directory:_files -/' \
        '--agent[Agent for the current session]:agent:' \
        '--agents[JSON object defining custom agents, or a file with --print]:json or file:_files' \
        '--allow-dangerously-skip-permissions[Enable bypassing permission checks as an option]' \
        '*'{--allowedTools,--allowed-tools}'[Tool names to allow]:tools:' \
        '--append-system-prompt[Append a system prompt to the default]:prompt:' \
        '--autocompact[Auto-compact window size]:size (auto or tokens):(auto)' \
        '--ax-screen-reader[Render screen-reader friendly output]' \
        {--bg,--background}'[Start the session in the background and return]' \
        '--bare[Minimal mode: skip hooks, LSP, plugin sync, auto-memory and CLAUDE.md discovery]' \
        '*--betas[Beta headers to include in API requests]:beta headers:' \
        '--brief[Enable SendUserMessage tool for agent-to-user communication]' \
        '(--no-chrome)--chrome[Enable Claude in Chrome integration]' \
        '--client-data-url[URL for a signed configuration document]:url:_urls' \
        '--cloud[Create or attach to a cloud session]::description, session id or url:' \
        {-c,--continue}'[Continue the most recent conversation]' \
        '--dangerously-skip-permissions[Bypass all permission checks]' \
        {-d,--debug}'[Enable debug mode with optional category filter]::filter:' \
        '--debug-file[Write debug logs to a specific file path]:path:_files' \
        '--disable-slash-commands[Disable all skills]' \
        '*'{--disallowedTools,--disallowed-tools}'[Tool names to deny]:tools:' \
        '--effort[Effort level for the current session]:level:(low medium high xhigh max)' \
        '--environment[Create a cloud session on a self-hosted environment]:environment id:' \
        '--exclude-dynamic-system-prompt-sections[Move per-machine system prompt sections into the first user message]' \
        '--fallback-model[Fallback model(s) when the default is unavailable]:model:' \
        '*--file[File resources to download at startup]:file_id\:relative_path:' \
        '--fork-session[Create a new session ID when resuming]' \
        '--forward-subagent-text[Forward subagent text and thinking blocks]' \
        '--from-pr[Resume a session linked to a PR]::pr number or url:' \
        '--ide[Automatically connect to IDE on startup]' \
        '--include-hook-events[Include hook lifecycle events in stream-json output]' \
        '--include-partial-messages[Include partial message chunks as they arrive]' \
        '--input-format[Input format (with --print)]:format:(text stream-json)' \
        '--json-schema[JSON Schema for structured output validation]:schema:' \
        '--max-budget-usd[Maximum dollar amount to spend on API calls]:amount:' \
        '*--mcp-config[Load MCP servers from JSON files or strings]:config:_files' \
        '--model[Model for the current session]:model:(fable opus sonnet)' \
        {-n,--name}'[Set a display name for this session]:name:' \
        '(--chrome)--no-chrome[Disable Claude in Chrome integration]' \
        '--no-session-persistence[Disable session persistence (with --print)]' \
        '--output-format[Output format (with --print)]:format:(text json stream-json)' \
        '--permission-mode[Permission mode for the session]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
        '--permission-prompts[Who answers permission prompts with --print]:target:(host none)' \
        '*--plugin-dir[Load a plugin from a directory or .zip for this session]:path:_files' \
        '*--plugin-url[Fetch a plugin .zip from a URL for this session]:url:_urls' \
        {-p,--print}'[Print response and exit]' \
        '--prompt-suggestions[Enable prompt suggestions]::value:(true false 1 0 yes no on off)' \
        '--remote-control[Start an interactive session with Remote Control enabled]::name:' \
        '--remote-control-session-name-prefix[Prefix for auto-generated Remote Control session names]:prefix:' \
        '--replay-user-messages[Re-emit user messages from stdin on stdout]' \
        '--restricted[Restricted mode: remove code-running tools and ignore settings files]' \
        {-r,--resume}'[Resume a conversation by session ID or open a picker]::session id or search term:' \
        '--safe-mode[Start with all customizations disabled]' \
        '--session-id[Use a specific session ID (valid UUID)]:uuid:' \
        '--setting-sources[Comma-separated setting sources to load]:sources:_sequence compadd - user project local' \
        '--settings[Settings JSON file or string]:file or json:_files' \
        '--strict-mcp-config[Only use MCP servers from --mcp-config]' \
        '--system-prompt[System prompt to use for the session]:prompt:' \
        '--system-prompt-snapshot[Record the system prompt once per conversation]:mode:(on off)' \
        '--teleport[Resume a teleport session]::session id:' \
        '--tmux=-[Create a tmux session for the worktree]::mode:(classic)' \
        '*--tools[Available tools from the built-in set]:tools:' \
        '--verbose[Override verbose mode setting from config]' \
        {-w,--worktree}'[Create a new git worktree for this session]::name:' \
        '1: :->command' \
        '*::arg:->args'

    case $state in
        command)
            _describe -t commands 'claude-code commands' commands
            ;;
        args)
            case $line[1] in
                agents)
                    _claude_code_agents
                    ;;
                attach|logs|stop|kill)
                    _arguments \
                        {-h,--help}'[Display help]' \
                        '1:background session id:'
                    ;;
                auth)
                    _claude_code_auth
                    ;;
                auto-mode)
                    _claude_code_auto_mode
                    ;;
                plugin|plugins)
                    _claude_code_plugin
                    ;;
                mcp)
                    _claude_code_mcp
                    ;;
                gateway)
                    _arguments \
                        '--config[Path to gateway YAML config]:path:_files -g "*.(yaml|yml)"' \
                        {-h,--help}'[Display help]'
                    ;;
                import)
                    _arguments \
                        '--dry-run[Show what would be imported without writing anything]' \
                        '--yes=-[Skip the interactive picker]::digest:' \
                        {-h,--help}'[Display help]' \
                        '1:source:(codex gemini cursor)'
                    ;;
                install)
                    _arguments \
                        '--force[Force installation even if already installed]' \
                        {-h,--help}'[Display help]' \
                        '1:target:(stable latest)'
                    ;;
                project)
                    _claude_code_project
                    ;;
                respawn)
                    _arguments \
                        '--all[Restart every background session]' \
                        {-h,--help}'[Display help]' \
                        '1:background session id:'
                    ;;
                rm)
                    _arguments \
                        '--discard-unpushed[Also discard the worktree'"'"'s unpushed commits]:commit@worktree-id:' \
                        '--force-remove-worktree[Delete the worktree directory even if removal failed]:worktree id:' \
                        {-h,--help}'[Display help]' \
                        '1:background session id:'
                    ;;
                ultrareview)
                    _arguments \
                        '--json[Print the raw bugs.json payload]' \
                        '(--post)--no-post[Do not post the findings to the PR]' \
                        '(--no-post)--post[Post the findings to the PR as you]' \
                        '--timeout[Maximum minutes to wait for the review]:minutes:' \
                        {-h,--help}'[Display help]' \
                        '1:PR number or base branch:'
                    ;;
                doctor|setup-token|update|upgrade)
                    _arguments \
                        {-h,--help}'[Display help]'
                    ;;
            esac
            ;;
    esac
}

