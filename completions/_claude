# Configured MCP server names, from `claude mcp list` lines of the form
# "name: command - status". Names can themselves contain colons.
_claude_code_mcp_servers() {
    setopt localoptions extendedglob
    local -a servers
    servers=(${${(M)${(f)"$(claude mcp list 2>/dev/null)"}:#[^[:space:]]##: *}%%: *})
    compadd -a servers
}

